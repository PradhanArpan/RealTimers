# Source data — too big for git, and re-downloadable from OpenCity.
data/*.kml
data/*.zip

# Derived data IS committed (data/drains.geojson) so Render never has to
# run the ingester at build time. Delete that line from here if you change
# your mind, but then add ingestion to the build command.

__pycache__/
*.pyc
.venv/
venv/
.env
.DS_Store

# Earth Engine exports -- inputs, 29 MB, re-exportable with the script in TERRAIN.md
data/ee/

# Full-resolution terrain rasters -- for QGIS, not needed by the server.
# The server uses streams/catchments GeoJSON, terrain_grid.npz and the HAND PNG.
data/terrain/*/rasters/

# osmnx download cache (written by tools/ingest_roads.py)
cache/

# SWMM binary results -- regenerate with tools/build_swmm_chennai.py
data/swmm/*/*.out
